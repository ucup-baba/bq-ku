# ==========================================
# Konfigurasi Supabase (Database & Storage)
# ==========================================
# Ambil dari: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Nama bucket penyimpanan berkas & foto santri (Wajib diset public di Supabase)
SUPABASE_STORAGE_BUCKET=berkas

# ==========================================
# Konfigurasi AI Vision OCR (Opsional)
# ==========================================
# Ambil dari: Google AI Studio (https://aistudio.google.com)
GEMINI_API_KEY=AIzaSy...

# URL publik aplikasi (dipakai untuk tautan upload mandiri & email auth)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Hostname situs publik Perpus BQ, dipisah koma. Kosong = situs perpus tidak aktif.
# Lokal: perpus.localhost (buka http://perpus.localhost:3000)
PERPUS_HOST=perpus.localhost

# Opsional: proyek Supabase terpisah untuk test integrasi (npm test)
SUPABASE_TEST_URL=
SUPABASE_TEST_SERVICE_ROLE_KEY=

# Kunci YouTube Data API v3 untuk tab Video situs perpus. Hanya server. Kosong = tab menampilkan tautan ke kanal.
YOUTUBE_API_KEY=
